{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Chart 2 - Interactive choropleth + state ranking for overseas-born population",
    "params": [
        {
            "name": "selectedYear",
            "value": 2021,
            "bind": {
                "input": "range",
                "min": 2001,
                "max": 2021,
                "step": 5,
                "name": "Year: "
            }
        }
    ],
    "hconcat": [
        {
            "name": "map_panel",
            "width": 680,
            "height": 440,
            "projection": {
                "type": "mercator"
            },
            "layer": [
                {
                    "data": {
                        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
                        "format": {
                            "type": "json",
                            "property": "features"
                        }
                    },
                    "transform": [
                        {
                            "lookup": "properties.STATE_NAME",
                            "from": {
                                "data": {
                                    "url": "data/Chart2-resident%20population%20by%20state%20and%20territory.csv"
                                },
                                "key": "State",
                                "fields": [
                                    "Abbr",
                                    "2001 (%)",
                                    "2006 (%)",
                                    "2011 (%)",
                                    "2016 (%)",
                                    "2021 (%)"
                                ]
                            }
                        },
                        {
                            "fold": [
                                "2001 (%)",
                                "2006 (%)",
                                "2011 (%)",
                                "2016 (%)",
                                "2021 (%)"
                            ],
                            "as": [
                                "Year",
                                "Population"
                            ]
                        },
                        {
                            "calculate": "toNumber(replace(datum.Year, ' (%)', ''))",
                            "as": "YearNum"
                        },
                        {
                            "calculate": "toNumber(datum.Population)",
                            "as": "PopulationPercent"
                        },
                        {
                            "filter": "datum.YearNum == selectedYear"
                        }
                    ],
                    "mark": {
                        "type": "geoshape",
                        "stroke": "#0f1220",
                        "strokeWidth": 1.2
                    },
                    "encoding": {
                        "color": {
                            "field": "PopulationPercent",
                            "type": "quantitative",
                            "title": "Overseas-born (%)",
                            "scale": {
                                "domain": [
                                    10,
                                    35
                                ],
                                "range": [
                                    "#121626",
                                    "#323c5a",
                                    "#687ca8",
                                    "#fbbf24",
                                    "#f5a623"
                                ]
                            },
                            "legend": {
                                "orient": "bottom",
                                "direction": "horizontal",
                                "titleOrient": "left",
                                "values": [
                                    10,
                                    15,
                                    20,
                                    25,
                                    30,
                                    35
                                ],
                                "labelColor": "#eef1ff",
                                "titleColor": "#eef1ff",
                                "labelFontSize": 11,
                                "titleFontSize": 12
                            }
                        },
                        "tooltip": [
                            {
                                "field": "properties.STATE_NAME",
                                "type": "nominal",
                                "title": "State / Territory"
                            },
                            {
                                "field": "YearNum",
                                "type": "quantitative",
                                "title": "Year",
                                "format": ".0f"
                            },
                            {
                                "field": "PopulationPercent",
                                "type": "quantitative",
                                "title": "Overseas-born (%)",
                                "format": ".1f"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "name": "bar_panel",
            "width": 260,
            "height": 440,
            "data": {
                "url": "data/Chart2-resident%20population%20by%20state%20and%20territory.csv"
            },
            "transform": [
                {
                    "fold": [
                        "2001 (%)",
                        "2006 (%)",
                        "2011 (%)",
                        "2016 (%)",
                        "2021 (%)"
                    ],
                    "as": [
                        "Year",
                        "Population"
                    ]
                },
                {
                    "calculate": "toNumber(replace(datum.Year, ' (%)', ''))",
                    "as": "YearNum"
                },
                {
                    "calculate": "toNumber(datum.Population)",
                    "as": "PopulationPercent"
                },
                {
                    "filter": "datum.YearNum == selectedYear"
                }
            ],
            "layer": [
                {
                    "mark": {
                        "type": "bar",
                        "cornerRadiusEnd": 3,
                        "size": 22
                    },
                    "encoding": {
                        "y": {
                            "field": "Abbr",
                            "type": "nominal",
                            "sort": {
                                "field": "PopulationPercent",
                                "order": "descending"
                            },
                            "title": null,
                            "axis": {
                                "labelColor": "#eef1ff",
                                "labelFontSize": 11,
                                "tickSize": 0,
                                "domain": false
                            }
                        },
                        "x": {
                            "field": "PopulationPercent",
                            "type": "quantitative",
                            "axis": null
                        },
                        "color": {
                            "field": "PopulationPercent",
                            "type": "quantitative",
                            "scale": {
                                "domain": [
                                    10,
                                    35
                                ],
                                "range": [
                                    "#323c5a",
                                    "#687ca8",
                                    "#fbbf24",
                                    "#f5a623"
                                ]
                            },
                            "legend": null
                        },
                        "tooltip": [
                            {
                                "field": "State",
                                "type": "nominal",
                                "title": "State / Territory"
                            },
                            {
                                "field": "Abbr",
                                "type": "nominal",
                                "title": "Abbreviation"
                            },
                            {
                                "field": "PopulationPercent",
                                "type": "quantitative",
                                "title": "Overseas-born (%)",
                                "format": ".1f"
                            }
                        ]
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "align": "left",
                        "dx": 5,
                        "dy": 0,
                        "fontSize": 10.5,
                        "fontWeight": 600,
                        "color": "#eef1ff"
                    },
                    "encoding": {
                        "y": {
                            "field": "Abbr",
                            "type": "nominal",
                            "sort": {
                                "field": "PopulationPercent",
                                "order": "descending"
                            }
                        },
                        "x": {
                            "field": "PopulationPercent",
                            "type": "quantitative"
                        },
                        "text": {
                            "field": "PopulationPercent",
                            "type": "quantitative",
                            "format": ".1f"
                        }
                    }
                }
            ],
            "title": {
                "text": "States by Overseas-born Share",
                "subtitle": "Ranked for selected year — drag slider to update",
                "fontSize": 13,
                "color": "#eef1ff",
                "subtitleColor": "#eef1ff",
                "subtitleFontSize": 10,
                "anchor": "start",
                "offset": 10
            }
        }
    ],
    "config": {
        "font": "Inter, sans-serif",
        "background": "transparent",
        "view": {
            "stroke": null
        },
        "axis": {
            "labelFont": "Inter, sans-serif",
            "titleFont": "Inter, sans-serif",
            "labelColor": "#eef1ff",
            "titleColor": "#eef1ff",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12
        },
        "title": {
            "font": "Inter, sans-serif",
            "fontSize": 14,
            "fontWeight": 600,
            "color": "#eef1ff",
            "subtitleFont": "Inter, sans-serif",
            "subtitleFontSize": 11,
            "subtitleColor": "#eef1ff",
            "subtitlePadding": 6
        },
        "legend": {
            "labelFont": "Inter, sans-serif",
            "titleFont": "Inter, sans-serif",
            "labelColor": "#eef1ff",
            "titleColor": "#eef1ff",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "symbolSize": 100
        },
        "text": {
            "font": "Inter, sans-serif",
            "color": "#eef1ff"
        }
    }
}