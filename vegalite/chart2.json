{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Chart 2 - Overseas-born resident population by Australian state and territory with year slider",
    "width": 700,
    "height": 500,
    "projection": {
        "type": "mercator",
        "center": [
            133,
            -28
        ],
        "scale": 700,
        "translate": [
            350,
            250
        ]
    },
    "params": [
        {
            "name": "selectedYear",
            "value": 2021,
            "bind": {
                "input": "range",
                "min": 2001,
                "max": 2021,
                "step": 5,
                "name": "Year: "
            }
        }
    ],
    "layer": [
        {
            "data": {
                "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
                "format": {
                    "type": "json",
                    "property": "features"
                }
            },
            "transform": [
                {
                    "lookup": "properties.STATE_NAME",
                    "from": {
                        "data": {
                            "url": "https://raw.githubusercontent.com/nngu0229/FIT2179/refs/heads/main/data/Chart2-resident%20population%20by%20state%20and%20territory.csv"
                        },
                        "key": "State",
                        "fields": [
                            "Abbr",
                            "2001 (%)",
                            "2006 (%)",
                            "2011 (%)",
                            "2016 (%)",
                            "2021 (%)"
                        ]
                    }
                },
                {
                    "fold": [
                        "2001 (%)",
                        "2006 (%)",
                        "2011 (%)",
                        "2016 (%)",
                        "2021 (%)"
                    ],
                    "as": [
                        "Year",
                        "Population"
                    ]
                },
                {
                    "calculate": "toNumber(replace(datum.Year, ' (%)', ''))",
                    "as": "YearNum"
                },
                {
                    "calculate": "toNumber(datum.Population)",
                    "as": "PopulationPercent"
                },
                {
                    "filter": "datum.YearNum == selectedYear"
                }
            ],
            "mark": {
                "type": "geoshape",
                "stroke": "#0f1220",
                "strokeWidth": 1.2
            },
            "encoding": {
                "color": {
                    "field": "PopulationPercent",
                    "type": "quantitative",
                    "title": "Overseas-born population (%)",
                    "scale": {
                        "domain": [
                            10,
                            35
                        ],
                        "range": [
                            "#121626",
                            "#323c5a",
                            "#687ca8",
                            "#fbbf24",
                            "#f5a623"
                        ]
                    },
                    "legend": {
                        "orient": "bottom",
                        "direction": "horizontal",
                        "titleOrient": "left",
                        "values": [
                            10,
                            15,
                            20,
                            25,
                            30,
                            35
                        ]
                    }
                },
                "tooltip": [
                    {
                        "field": "properties.STATE_NAME",
                        "type": "nominal",
                        "title": "State/Territory"
                    },
                    {
                        "field": "YearNum",
                        "type": "quantitative",
                        "title": "Year",
                        "format": ".0f"
                    },
                    {
                        "field": "PopulationPercent",
                        "type": "quantitative",
                        "title": "Overseas-born population",
                        "format": ".1f"
                    }
                ]
            }
        }
    ],
    "title": {
        "text": "Where Migrants Settle in Australia",
        "subtitle": "Share of resident population born overseas by state and territory, 2001–2021",
        "fontSize": 16,
        "subtitleFontSize": 12
    },
    "config": {
        "font": "Inter, sans-serif",
        "background": "transparent",
        "view": {
            "stroke": null
        },
        "axis": {
            "labelFont": "Inter, sans-serif",
            "titleFont": "Inter, sans-serif",
            "labelColor": "#8898ba",
            "titleColor": "#eef1ff",
            "tickColor": "rgba(255,255,255,0.15)",
            "domainColor": "rgba(255,255,255,0.15)",
            "gridColor": "rgba(255,255,255,0.08)",
            "grid": true,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12
        },
        "title": {
            "font": "Inter, sans-serif",
            "fontSize": 16,
            "fontWeight": 600,
            "color": "#eef1ff",
            "subtitleFont": "Inter, sans-serif",
            "subtitleFontSize": 12,
            "subtitleColor": "#8898ba",
            "subtitlePadding": 6
        },
        "legend": {
            "labelFont": "Inter, sans-serif",
            "titleFont": "Inter, sans-serif",
            "labelColor": "#8898ba",
            "titleColor": "#eef1ff",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "symbolSize": 100
        },
        "text": {
            "font": "Inter, sans-serif",
            "color": "#eef1ff"
        }
    }
}