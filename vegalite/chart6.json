{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "Temporary Visa Holders in Australia by Category",
        "subtitle": "COVID-19 caused a sharp drop in 2020–2021 across all visa types",
        "fontSize": 16,
        "subtitleFontSize": 12
    },
    "width": 700,
    "height": 420,
    "data": {
        "url": "data/chart6%20-%20visa%20categories.csv"
    },
    "transform": [
        {
            "filter": "datum['Visa Category'] != 'Grand Total'"
        },
        {
            "calculate": "indexof(['Crew and Transit','Temporary Resident (Other Employment)','Temporary Graduate','Other Temporary','Temporary Protection'], datum['Visa Category']) >= 0 ? 'Other' : datum['Visa Category']",
            "as": "Category"
        },
        {
            "fold": [
                "2011",
                "2012",
                "2013",
                "2014",
                "2015",
                "2016",
                "2017",
                "2018",
                "2019",
                "2020",
                "2021",
                "2022",
                "2023",
                "2024",
                "2025"
            ],
            "as": [
                "Year",
                "Raw"
            ]
        },
        {
            "calculate": "toNumber(replace(replace(datum.Raw, ',', ''), ' ', ''))",
            "as": "Value"
        },
        {
            "filter": "datum.Value > 0"
        },
        {
            "aggregate": [
                {
                    "op": "sum",
                    "field": "Value",
                    "as": "Value"
                }
            ],
            "groupby": [
                "Category",
                "Year"
            ]
        }
    ],
    "layer": [
        {
            "mark": {
                "type": "bar"
            },
            "encoding": {
                "x": {
                    "field": "Year",
                    "type": "ordinal",
                    "axis": {
                        "labelAngle": -45,
                        "title": "Year",
                        "labelFontSize": 11
                    }
                },
                "y": {
                    "field": "Value",
                    "type": "quantitative",
                    "stack": true,
                    "axis": {
                        "title": "Number of Visa Holders",
                        "format": "~s",
                        "labelFontSize": 11
                    }
                },
                "color": {
                    "field": "Category",
                    "type": "nominal",
                    "sort": {
                        "op": "sum",
                        "field": "Value",
                        "order": "desc"
                    },
                    "scale": {
                        "domain": [
                            "Temporary Resident (Skilled Employment)",
                            "Student",
                            "Working Holiday Maker",
                            "Visitor",
                            "Special Category",
                            "Bridging",
                            "Other"
                        ],
                        "range": [
                            "#10d9a0",
                            "#22d3ee",
                            "#06b6d4",
                            "#0284c7",
                            "#a78bfa",
                            "#6366f1",
                            "#4e5c7a"
                        ]
                    },
                    "legend": {
                        "title": "Visa Category",
                        "labelFontSize": 11,
                        "titleFontSize": 12,
                        "columns": 3,
                        "direction": "horizontal",
                        "orient": "bottom"
                    }
                },
                "tooltip": [
                    {
                        "field": "Category",
                        "type": "nominal",
                        "title": "Category"
                    },
                    {
                        "field": "Year",
                        "type": "ordinal"
                    },
                    {
                        "field": "Value",
                        "type": "quantitative",
                        "title": "Visa Holders",
                        "format": ","
                    }
                ]
            }
        },
        {
            "data": {
                "values": [
                    {
                        "Year": "2020"
                    }
                ]
            },
            "mark": {
                "type": "rule",
                "color": "#eef1ff",
                "strokeDash": [
                    4,
                    4
                ],
                "strokeWidth": 1.5,
                "opacity": 0.5
            },
            "encoding": {
                "x": {
                    "field": "Year",
                    "type": "ordinal"
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "Year": "2020",
                        "y": 3300000
                    }
                ]
            },
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 6,
                "dy": -6,
                "fontSize": 11,
                "fontStyle": "italic",
                "color": "#eef1ff",
                "opacity": 0.8
            },
            "encoding": {
                "x": {
                    "field": "Year",
                    "type": "ordinal"
                },
                "y": {
                    "field": "y",
                    "type": "quantitative"
                },
                "text": {
                    "value": "COVID-19 border closure"
                }
            }
        }
    ],
    "config": {
        "font": "Inter, sans-serif",
        "background": "transparent",
        "view": {
            "stroke": null
        },
        "axis": {
            "labelFont": "Inter, sans-serif",
            "titleFont": "Inter, sans-serif",
            "labelColor": "#8898ba",
            "titleColor": "#eef1ff",
            "tickColor": "rgba(255,255,255,0.15)",
            "domainColor": "rgba(255,255,255,0.15)",
            "gridColor": "rgba(255,255,255,0.08)",
            "grid": true,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12
        },
        "title": {
            "font": "Inter, sans-serif",
            "fontSize": 16,
            "fontWeight": 600,
            "color": "#eef1ff",
            "subtitleFont": "Inter, sans-serif",
            "subtitleFontSize": 12,
            "subtitleColor": "#8898ba",
            "subtitlePadding": 6
        },
        "legend": {
            "labelFont": "Inter, sans-serif",
            "titleFont": "Inter, sans-serif",
            "labelColor": "#8898ba",
            "titleColor": "#eef1ff",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "symbolSize": 100
        },
        "text": {
            "font": "Inter, sans-serif",
            "color": "#eef1ff"
        }
    }
}