{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annual Population Change - Australia",
  "width": 700,
  "height": 400,
  "data": {
    "url": "data/Chart1-annual%20population%20change.csv"
  },
  "transform": [
    {
      "filter": "datum.Time != null && datum.Time != '' && datum['Total growth'] != null && datum['Total growth'] != ''"
    },
    {
      "calculate": "toNumber(replace(datum['Natural increase'], ',', ''))",
      "as": "Natural Increase"
    },
    {
      "calculate": "toNumber(replace(datum['Net overseas migration'], ',', ''))",
      "as": "Net Overseas Migration"
    },
    {
      "calculate": "toNumber(replace(datum['Total growth'], ',', ''))",
      "as": "Total Growth"
    },
    {
      "fold": [
        "Natural Increase",
        "Net Overseas Migration",
        "Total Growth"
      ],
      "as": [
        "Series",
        "Value"
      ]
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "start": "20-Dec",
            "end": "23-Dec"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "opacity": 0.1,
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "ordinal"
        },
        "x2": {
          "field": "end"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "Time",
          "type": "ordinal",
          "axis": {
            "labelAngle": -45,
            "labelOverlap": true,
            "labelFontSize": 9
          },
          "title": "Year",
          "fontColor": "#ffffff"
        },
        "y": {
          "field": "Value",
          "type": "quantitative",
          "title": "Annual Population Change",
          "axis": {
            "format": ",.0f"
          }
        },
        "color": {
          "field": "Series",
          "type": "nominal",
          "title": "Component",
          "scale": {
            "domain": [
              "Natural Increase",
              "Net Overseas Migration",
              "Total Growth"
            ],
            "range": [
              "#a78bfa",
              "#fbbf24",
              "#ff6b6b"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleOrient": "left"
          }
        },
        "tooltip": [
          {
            "field": "Time",
            "type": "ordinal",
            "title": "Quarter"
          },
          {
            "field": "Series",
            "type": "nominal",
            "title": "Component"
          },
          {
            "field": "Value",
            "type": "quantitative",
            "title": "Value",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "Time": "21-Dec",
            "Value": 680000,
            "label": "COVID-19 border closures\nmigration drops"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "lineBreak": "\n",
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "Time",
          "type": "ordinal"
        },
        "y": {
          "field": "Value",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif",
      "labelColor": "#eef1ff",
      "titleColor": "#eef1ff",
      "tickColor": "rgba(255,255,255,0.15)",
      "domainColor": "rgba(255,255,255,0.15)",
      "gridColor": "rgba(255,255,255,0.08)",
      "grid": true,
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titlePadding": 12
    },
    "title": {
      "font": "Inter, sans-serif",
      "fontSize": 16,
      "fontWeight": 600,
      "color": "#eef1ff",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#eef1ff",
      "subtitlePadding": 6
    },
    "legend": {
      "labelFont": "Inter, sans-serif",
      "titleFont": "Inter, sans-serif",
      "labelColor": "#eef1ff",
      "titleColor": "#eef1ff",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "symbolSize": 100
    },
    "text": {
      "font": "Inter, sans-serif",
      "color": "#eef1ff"
    }
  }
}