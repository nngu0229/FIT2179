      "width": 260,
      "height": 460,
      "data": {
        "values": [
          {
            "STATE_NAME": "Australia",
            "nom": "396,400",
            "share": "100.0%",
            "density": "National Overview",
            "line1": "Migration is highly concentrated in capital",
            "line2": "cities. Click any state on the map to explore",
            "line3": "regional stats. Hover over dots to see",
            "line4": "suburb-level Net Migration (NOM) details."
          },
          {
            "STATE_NAME": "New South Wales",
            "nom": "125,800",
            "share": "31.7%",
            "density": "Extremely High",
            "line1": "NSW dominates national intake, with Sydney",
            "line2": "absorbing the vast majority of skilled and",
            "line3": "student arrivals, forming intense clusters",
            "line4": "along the eastern metropolitan coastline."
          },
          {
            "STATE_NAME": "Victoria",
            "nom": "114,200",
            "share": "28.8%",
            "density": "Extremely High",
            "line1": "Victoria's migration is heavily centred in",
            "line2": "metropolitan Melbourne, driving rapid urban",
            "line3": "expansion and workforce support across",
            "line4": "construction, retail, and healthcare."
          },
          {
            "STATE_NAME": "Queensland",
            "nom": "59,400",
            "share": "15.0%",
            "density": "Very High",
            "line1": "Queensland's migration is more distributed,",
            "line2": "spreading across Brisbane, the Gold Coast,",
            "line3": "and regional agricultural or tourist zones",
            "line4": "along the eastern seaboard."
          },
          {
            "STATE_NAME": "Western Australia",
            "nom": "52,700",
            "share": "13.3%",
            "density": "Very High",
            "line1": "WA attracts skilled workers to fuel mining,",
            "line2": "resources, and engineering sectors, heavily",
            "line3": "concentrated in Perth's metropolitan hubs",
            "line4": "and key regional resource capitals."
          },
          {
            "STATE_NAME": "South Australia",
            "nom": "22,800",
            "share": "5.8%",
            "density": "High / Moderate",
            "line1": "South Australia uses targeted migration to",
            "line2": "address skilled shortages in its defence,",
            "line3": "manufacturing, agricultural, and high-tech",
            "line4": "sectors in Adelaide and surrounds."
          },
          {
            "STATE_NAME": "Tasmania",
            "nom": "4,200",
            "share": "1.1%",
            "density": "Low / Moderate",
            "line1": "Tasmania's intake is smaller but vital for",
            "line2": "addressing demographic ageing, providing",
            "line3": "essential labour for regional healthcare,",
            "line4": "education, and agricultural sectors."
          },
          {
            "STATE_NAME": "Northern Territory",
            "nom": "2,700",
            "share": "0.7%",
            "density": "Low",
            "line1": "The Northern Territory relies on targeted",
            "line2": "regional agreements to attract skilled and",
            "line3": "semi-skilled workers to sustain vital public",
            "line4": "services and primary industries."
          },
          {
            "STATE_NAME": "Australian Capital Territory",
            "nom": "14,600",
            "share": "3.7%",
            "density": "High / Moderate",
            "line1": "The ACT attracts highly educated professional",
            "line2": "migrants, focused on public administration,",
            "line3": "education, and research institutions across",
            "line4": "the Canberra metropolitan region."
          }
        ]
      },
      "transform": [
        {
          "filter": "length(data('stateSelect_store')) === 0 ? datum.STATE_NAME === 'Australia' : vlSelectionTest('stateSelect_store', datum)"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "x": 0,
            "y": 10,
            "fontSize": 30,
            "fontWeight": "bold",
            "color": "#eef1ff"
          },
          "encoding": {
            "text": {
              "field": "STATE_NAME",
              "type": "nominal"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "x": 0,
            "y": 72,
            "fontSize": 14,
            "fontWeight": 600,
            "color": "#8898ba"
          },
          "encoding": {
            "text": {
              "value": "NET OVERSEAS MIGRATION (NOM)"
            }
