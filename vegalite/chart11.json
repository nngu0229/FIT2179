            "type": "text",
            "align": "left",
            "baseline": "top",
            "x": 0,
            "y": 381,
            "fontSize": 18,
            "color": "#8898ba"
          },
          "encoding": {
            "text": {
              "field": "line3",
              "type": "nominal"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "x": 0,
            "y": 399,
            "fontSize": 18,
            "color": "#8898ba"
          },
          "encoding": {
            "text": {
              "field": "line4",
              "type": "nominal"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "x": 0,
            "y": 445,
            "fontSize": 15,
            "fontStyle": "italic",
            "color": "#3d4f6e"
          },
          "encoding": {
            "text": {
              "value": "Click a state on the map  \u00b7  Double-click to reset"
            }
          }
        }
      ]
    },
    {
      "name": "map_panel",
      "width": 680,
      "height": 460,
      "projection": {
        "type": "mercator"
      },
      "layer": [
        {
          "params": [
            {
              "name": "stateSelect",
              "select": {
                "type": "point",
                "fields": [
                  "STATE_NAME"
                ],
                "on": "click",
                "toggle": false,
                "clear": "dblclick"
              }
            }
          ],
          "data": {
            "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "transform": [
            {
              "calculate": "datum.properties.STATE_NAME",
              "as": "STATE_NAME"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "#1e293b",
            "strokeWidth": 0.8,
            "cursor": "pointer"
          },
          "encoding": {
            "color": {
              "condition": {
                "param": "stateSelect",
                "empty": true,
                "value": "rgba(245, 166, 35, 0.1)"
              },
              "value": "#0b0d18"
            },
            "tooltip": [
              {
                "field": "STATE_NAME",
                "type": "nominal",
                "title": "Click to explore"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/chart11_dot_density_points.csv",
            "format": {
              "type": "csv",
              "parse": {
                "longitude": "number",
                "latitude": "number",
                "NOM_2024_25": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.longitude >= 110 && datum.longitude <= 155 && datum.latitude >= -45 && datum.latitude <= -9"
            },
            {
              "calculate": "datum.State_Name",
              "as": "STATE_NAME"
            },
            {
              "filter": {
                "param": "stateSelect",
                "empty": true
              }
            }
          ],
          "mark": {
            "type": "circle",
            "size": 15,
            "color": "#f5a623",
            "opacity": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "longitude",
              "type": "quantitative"
            },
            "latitude": {
              "field": "latitude",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "SA2_Name",
                "type": "nominal",
                "title": "Suburb (SA2)"
              },
              {
                "field": "State_Name",
                "type": "nominal",
                "title": "State"
              },
              {
                "field": "NOM_2024_25",
                "type": "quantitative",
                "title": "Net Overseas Migration (NOM)",
                "format": ","
              },
              {
                "field": "Dot_Value",
                "type": "quantitative",
                "title": "1 Dot Equals",
                "format": ",d"
              }
            ]
          }
        }
      ]
    }
  ],
  "title": null
}