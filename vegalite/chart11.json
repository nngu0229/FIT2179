      "font": "Inter, sans-serif",
      "fontSize": 20,
      "fontWeight": 600,
      "color": "#eef1ff",
      "subtitleFont": "Inter, sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#8898ba",
      "subtitlePadding": 12
    }
  },
  "hconcat": [
    {
