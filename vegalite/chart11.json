            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "x": 0,
            "y": 345,
            "fontSize": 18,
            "color": "#8898ba"
          },
          "encoding": {
            "text": {
