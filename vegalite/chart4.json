{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 720,
    "height": 420,
    "data": {
        "url": "data/chart4%20-%20Migrant%20workers%20by%20industry%20and%20state%20.csv"
    },
    "transform": [
        {
            "filter": "datum['Number of Jobs'] != null && datum['Number of Jobs'] != 'np' && datum['Number of Jobs'] != '-'"
        },
        {
            "calculate": "toNumber(replace(replace(datum['Number of Jobs'], ',', ''), ' ', ''))",
            "as": "Jobs"
        },
        {
            "filter": "datum.Industry == 'Construction' || datum.Industry == 'Health Care and Social Assistance' || datum.Industry == 'Professional, Scientific and Technical Services' || datum.Industry == 'Accommodation and Food Services' || datum.Industry == 'Information Media and Telecommunications' || datum.Industry == 'Education and Training' || datum.Industry == 'Retail Trade' || datum.Industry == 'Manufacturing'"
        }
    ],
    "mark": {
        "type": "rect",
        "cornerRadius": 0,
        "opacity": 1
    },
    "encoding": {
        "x": {
            "field": "Industry",
            "type": "ordinal",
            "title": null,
            "axis": {
                "labelAngle": -35,
                "labelFontSize": 10,
                "labelLimit": 160
            }
        },
        "y": {
            "field": "State Name",
            "type": "ordinal",
            "title": null
        },
        "color": {
            "field": "Jobs",
            "type": "quantitative",
            "title": "Migrant workers",
            "scale": {
                "domain": [
                    50,
                    8000
                ],
                "range": [
                    "#fbbf24",
                    "#faaa2e",
                    "#f99538",
                    "#f87f42",
                    "#f76a4c",
                    "#f55455",
                    "#f43f5e"
                ]
            },
            "legend": {
                "format": ",.0f"
            }
        },
        "tooltip": [
            {
                "field": "State Name",
                "type": "nominal",
                "title": "State"
            },
            {
                "field": "Industry",
                "type": "nominal",
                "title": "Industry"
            },
            {
                "field": "Jobs",
                "type": "quantitative",
                "title": "Jobs",
                "format": ",.0f"
            }
        ]
    },
    "title": {
        "text": "Migrant Workers Support Key Australian Industries",
        "subtitle": "Temporary skilled migrant workers by industry and state, 2022–23"
    },
    "config": {
        "font": "Inter, sans-serif",
        "background": "transparent",
        "view": {
            "stroke": null
        },
        "axis": {
            "labelFont": "Inter, sans-serif",
            "titleFont": "Inter, sans-serif",
            "labelColor": "#8898ba",
            "titleColor": "#eef1ff",
            "tickColor": "rgba(255,255,255,0.15)",
            "domainColor": "rgba(255,255,255,0.15)",
            "gridColor": "rgba(255,255,255,0.08)",
            "grid": false,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12
        },
        "title": {
            "font": "Inter, sans-serif",
            "fontSize": 16,
            "fontWeight": 600,
            "color": "#eef1ff",
            "subtitleFont": "Inter, sans-serif",
            "subtitleFontSize": 12,
            "subtitleColor": "#8898ba",
            "subtitlePadding": 6
        },
        "legend": {
            "labelFont": "Inter, sans-serif",
            "titleFont": "Inter, sans-serif",
            "labelColor": "#8898ba",
            "titleColor": "#eef1ff",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "symbolSize": 100
        },
        "text": {
            "font": "Inter, sans-serif",
            "color": "#eef1ff"
        }
    }
}