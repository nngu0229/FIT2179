        ]
    },
    "layer": [
        {
            "mark": {
                "type": "line",
                "strokeWidth": 3
            },
            "encoding": {
                "x": {
                    "field": "year",
                    "type": "ordinal",
                    "axis": {
                        "labelFontSize": 13,
                        "labelFontWeight": "bold",
                        "domain": true,
                        "ticks": false,
                        "grid": false,
                        "orient": "bottom",
                        "labelPadding": 10,
                        "labelAngle": 0
                    },
                    "title": "Year"
                },
                "y": {
                    "field": "pop",
                    "type": "quantitative",
                    "axis": {
                        "title": "Population ('000)",
                        "grid": true,
                        "gridOpacity": 1
                    },
                    "scale": {
                        "zero": false,
                        "padding": 30
                    }
                },
                "color": {
                    "field": "country",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "India",
                            "England",
                            "China",
                            "New Zealand",
                            "Philippines",
                            "Vietnam",
                            "South Africa",
                            "Sri Lanka"
                        ],
                        "range": [
                            "#FFC300",
                            "#FFC300",
                            "#B5179E",
                            "#CF68C0",
                            "#B5179E",
                            "#CF68C0",
                            "#B5179E",
                            "#CF68C0"
                        ]
                    },
                    "legend": null
                },
                "detail": {
                    "field": "country"
                }
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 80
            },
            "encoding": {
                "x": {
                    "field": "year",
                    "type": "ordinal"
                },
                "y": {
                    "field": "pop",
                    "type": "quantitative",
                    "scale": {
                        "zero": false,
                        "padding": 30
                    }
                },
                "color": {
                    "field": "country",
                    "type": "nominal",
                    "legend": null
                },
                "tooltip": [
                    {
                        "field": "country",
                        "type": "nominal",
                        "title": "Country"
                    },
                    {
                        "field": "year",
                        "type": "ordinal",
                        "title": "Year"
                    },
                    {
                        "field": "pop",
                        "type": "quantitative",
                        "title": "Population ('000)",
                        "format": ".1f"
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.year == '2015'"
                },
                {
                    "calculate": "datum.country == 'Philippines' ? datum.pop + 18 : datum.country == 'Vietnam' ? datum.pop - 18 : datum.country == 'Malaysia' ? datum.pop + 16 : datum.country == 'Sri Lanka' ? datum.pop - 16 : datum.country == 'South Africa' ? datum.pop + 10 : datum.pop",
                    "as": "pop_offset"
                }
            ],
            "mark": {
                "type": "text",
                "align": "right",
                "dx": -10,
                "fontSize": 11,
                "fontWeight": 500
            },
            "encoding": {
                "x": {
                    "field": "year",
                    "type": "ordinal"
                },
                "y": {
                    "field": "pop_offset",
                    "type": "quantitative",
                    "scale": {
                        "zero": false,
                        "padding": 30
                    }
                },
                "text": {
                    "field": "country",
                    "type": "nominal"
                },
                "color": {
                    "field": "country",
                    "type": "nominal",
                    "legend": null
                }
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.year == '2025'"
                },
                {
                    "calculate": "datum.country == 'England' ? datum.pop + 18 : datum.country == 'India' ? datum.pop - 18 : datum.country == 'Malaysia' ? datum.pop + 16 : datum.country == 'Sri Lanka' ? datum.pop - 16 : datum.country == 'South Africa' ? datum.pop + 10 : datum.pop",
                    "as": "pop_offset"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 10,
                "fontSize": 11,
                "fontWeight": 500
            },
            "encoding": {
                "x": {
                    "field": "year",
                    "type": "ordinal"
                },
                "y": {
                    "field": "pop_offset",
                    "type": "quantitative",
                    "scale": {
                        "zero": false,
                        "padding": 30
                    }
                },
                "text": {
                    "field": "country",
                    "type": "nominal"
                },
                "color": {
                    "field": "country",
                    "type": "nominal",
                    "legend": null
                }
            }
        }
    ],
    "config": {
        "axis": {
            "labelColor": "#ffffff",
            "titleColor": "#ffffff",
            "tickColor": "#ffffff",
            "domainColor": "#ffffff",
            "gridColor": "rgba(255,255,255,0.2)"
        },
        "title": {
            "color": "#ffffff",
            "subtitleColor": "#ffffff"
        },
        "legend": {
            "labelColor": "#ffffff",
            "titleColor": "#ffffff"
        },
        "text": {
            "color": "#ffffff"
        },
        "view": {
            "stroke": null
        }
    }
}