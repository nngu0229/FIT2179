                {
                    "calculate": "datum.country == 'England' ? datum.pop + 20 : datum.country == 'India' ? datum.pop - 20 : datum.country == 'South Africa' ? datum.pop + 32 : datum.country == 'Nepal' ? datum.pop + 12 : datum.country == 'Sri Lanka' ? datum.pop - 10 : datum.country == 'Malaysia' ? datum.pop - 30 : datum.pop",
