{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Vertical bar chart of jobs held by migrant workers",
    "width": 720,
    "height": 420,
    "data": {
        "values": [
            {
                "Occupation": "Registered Nurses",
                "Jobs": 8200
            },
            {
                "Occupation": "Software Engineers",
                "Jobs": 6400
            },
            {
                "Occupation": "Chefs",
                "Jobs": 5900
            },
            {
                "Occupation": "Electricians",
                "Jobs": 4200
            },
            {
                "Occupation": "Construction Managers",
                "Jobs": 3900
            },
            {
                "Occupation": "Accountants",
                "Jobs": 3600
            },
            {
                "Occupation": "Aged Care Workers",
                "Jobs": 3400
            },
            {
                "Occupation": "ICT Business Analysts",
                "Jobs": 3100
            },
            {
                "Occupation": "Secondary School Teachers",
                "Jobs": 2900
            },
            {
                "Occupation": "Motor Mechanics",
                "Jobs": 2500
            }
        ]
    },
    "layer": [
        {
            "mark": {
                "type": "bar",
                "cornerRadiusTopLeft": 4,
                "cornerRadiusTopRight": 4
            },
            "encoding": {
                "x": {
                    "field": "Occupation",
                    "type": "ordinal",
                    "sort": "-y",
                    "title": null,
                    "axis": {
                        "labelAngle": -35,
                        "labelFontSize": 10,
                        "labelLimit": 150
                    }
                },
                "y": {
                    "field": "Jobs",
                    "type": "quantitative",
                    "title": "Number of migrant workers",
                    "axis": {
                        "format": ",.0f"
                    }
                },
                "color": {
                    "field": "Jobs",
                    "type": "quantitative",
                    "scale": {
                        "range": [
                            "#fbbf24",
                            "#f43f5e"
                        ]
                    },
                    "legend": null
                },
                "tooltip": [
                    {
                        "field": "Occupation",
                        "type": "nominal"
                    },
                    {
                        "field": "Jobs",
                        "type": "quantitative",
                        "title": "Migrant workers",
                        "format": ",.0f"
                    }
                ]
            }
        },
        {
            "mark": {
                "type": "text",
                "dy": -8,
                "fontSize": 10,
                "fontWeight": "bold",
                "color": "#ffffff"
            },
            "encoding": {
                "x": {
                    "field": "Occupation",
                    "type": "ordinal",
                    "sort": "-y"
                },
                "y": {
                    "field": "Jobs",
                    "type": "quantitative"
                },
                "text": {
                    "field": "Jobs",
                    "type": "quantitative",
                    "format": ",.0f"
                }
            }
        }
    ],
    "title": {
        "text": "Top Occupations Filled by Skilled Migrants",
        "subtitle": "Skilled migrants support workforce shortages",
        "fontSize": 18,
        "subtitleFontSize": 12
    },
    "config": {
        "font": "Inter, sans-serif",
        "background": "transparent",
        "view": {
            "stroke": null
        },
        "axis": {
            "labelFont": "Inter, sans-serif",
            "titleFont": "Inter, sans-serif",
            "labelColor": "#b6c4e0",
            "titleColor": "#eef1ff",
            "tickColor": "rgba(255,255,255,0.15)",
            "domainColor": "rgba(255,255,255,0.15)",
            "gridColor": "rgba(255,255,255,0.08)",
            "grid": true,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "titlePadding": 12
        },
        "title": {
            "font": "Inter, sans-serif",
            "fontSize": 16,
            "fontWeight": 600,
            "color": "#eef1ff",
            "subtitleFont": "Inter, sans-serif",
            "subtitleFontSize": 12,
            "subtitleColor": "#b6c4e0",
            "subtitlePadding": 6
        },
        "legend": {
            "labelFont": "Inter, sans-serif",
            "titleFont": "Inter, sans-serif",
            "labelColor": "#b6c4e0",
            "titleColor": "#eef1ff",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "symbolSize": 100
        },
        "text": {
            "font": "Inter, sans-serif",
            "color": "#eef1ff"
        }
    }
}