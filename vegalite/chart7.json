                            "#06b6d4",
                            "#0891b2",
                            "#0369a1",
                            "#0284c7",
                            "#0ea5e9",
                            "#38bdf8"
                        ]
                    },
                    "legend": {
                        "title": "Industry Sector",
                        "labelFontSize": 11,
                        "titleFontSize": 12,
                        "columns": 4,
                        "direction": "horizontal",
                        "orient": "bottom"
                    }
                },
                "order": {
                    "field": "GDP",
                    "type": "quantitative",
                    "sort": "descending"
                },
                "opacity": {
                    "condition": {
                        "param": "sector_select",
                        "value": 0.85
                    },
                    "value": 0.1
                },
                "tooltip": [
                    {
                        "field": "Industry",
                        "type": "nominal",
                        "title": "Industry"
                    },
                    {
                        "field": "Sector",
                        "type": "nominal",
                        "title": "Sector"
                    },
                    {
                        "field": "Shortage",
                        "type": "quantitative",
                        "title": "Skill Shortage (%)"
                    },
                    {
                        "field": "Migrant",
                        "type": "quantitative",
                        "title": "Migrant Share (%)"
                    },
                    {
                        "field": "GDP",
                        "type": "quantitative",
                        "title": "GDP ($M)",
                        "format": ",.0f"
                    }
                ]
            }
        }
