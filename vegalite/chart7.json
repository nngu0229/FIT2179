    "layer": [
        {
            "mark": {
                "type": "circle",
                "stroke": "white",
                "strokeWidth": 1.2
            },
            "params": [
                {
                    "name": "sector_select",
                    "select": {
                        "type": "point",
                        "fields": [
                            "Sector"
                        ]
                    },
                    "bind": "legend"
                }
            ],
            "encoding": {
                "x": {
                    "field": "Shortage",
                    "type": "quantitative",
                    "title": "Industry Skill Shortage (%)",
                    "scale": {
                        "domain": [
                            24,
                            60
                        ]
                    },
                    "axis": {
                        "labelFontSize": 11,
                        "titleFontSize": 12
                    }
                },
                "y": {
                    "field": "Migrant",
                    "type": "quantitative",
                    "title": "Migrant Workforce Share (%)",
                    "scale": {
                        "domain": [
                            4,
                            26
                        ]
                    },
                    "axis": {
                        "labelFontSize": 11,
                        "titleFontSize": 12
                    }
                },
                "size": {
                    "field": "GDP",
                    "type": "quantitative",
                    "scale": {
                        "range": [
                            80,
                            5000
                        ]
                    },
                    "legend": null
                },
                "color": {
                    "field": "Sector",
                    "type": "nominal",
                    "title": "Industry Sector",
                    "scale": {
                        "domain": [
                            "Financial",
                            "Professional Services",
                            "Info, media & telecomms",
                            "Healthcare & social",
                            "Accommodation",
                            "Transport",
                            "Wholesale",
